<div class="certificates-list">
  {% assign certificates = data[1] | sort: 'date' | reverse %}
  {% for content in certificates %}
    <div class="certificate-item">
      <div class="certificate-left">
        {% if content.icon %}
          <i class="{{ content.icon }} cert-icon" aria-hidden="true"></i>
        {% endif %}
        <a href="{{ content.url | default: '#' }}" class="cert-name">{{ content.name }}</a>
      </div>

      <div class="certificate-meta">
        <span class="cert-issuer">{{ content.issuer }}</span>
        &nbsp;—&nbsp;
        <span class="cert-date">
          {%- assign formatted = content.date | date: "%b %Y" -%}
          {%- if formatted == content.date -%}
            {{ content.date }}
          {%- else -%}
            {{ formatted }}
          {%- endif -%}
        </span>
      </div>
    </div>
  {% endfor %}
</div>
